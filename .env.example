APP_ENV=development
PORT=8080
DATABASE_URL=postgres://savorly:savorly_local_only@localhost:54329/savorly?sslmode=disable
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
SEED_DATA=true
OPENROUTER_API_KEY=
# Fast cooking Q&A, substitutions, and nutrition estimates.
OPENROUTER_TEXT_MODEL=openai/gpt-6-luna
# Structured recipe generation/adaptation and meal-plan suggestions.
OPENROUTER_RECIPE_MODEL=openai/gpt-6.1-sol
# Interactive sous-chef tools and photo understanding, including Live delegations.
OPENROUTER_AGENT_MODEL=openai/gpt-6-luna
# GPT Image 2.5's speed-focused variant, one medium-quality 4:3 cover.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-flare
# Photo touch-ups (profile and recipe photos): GPT Image 2.5's stronger editing variant.
OPENROUTER_IMAGE_EDIT_MODEL=openai/gpt-image-2.5-sunburst
REAPI_API_KEY=
REAPI_VIDEO_MODEL=doubao-seedance-2.5-eco
# Local SeaweedFS. Production uses R2 with the same S3_* settings; see docs/STORAGE.md.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=savorly_local
S3_SECRET_ACCESS_KEY=savorly_local_only_change_for_any_shared_environment
S3_BUCKET=savorly-media
S3_PUBLIC_URL=http://localhost:8333/savorly-media
S3_FORCE_PATH_STYLE=true
# Optional password-reset email through Cloudflare Email Service (docs/ACCOUNTS.md). Onboard
# the sender's domain under Email Sending first; the token needs only Email Sending: Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
# A plain address on the onboarded domain, e.g. noreply@savorly.cooking.
EMAIL_FROM=
# Plans set each member's 30-day allowances and AI spend ceiling (docs/PRICING.md).
# Free members share this daily budget, plus 15% of paying members' daily net revenue.
AI_FREE_DAILY_BUDGET_USD=5
# Hard daily circuit breaker for everyone, plus each paying member's ceiling / 30.
AI_DAILY_BUDGET_USD=25
# Voice conversations (server only). Requires a project with GPT-Live access.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=gleam
# Cooking read-aloud uses OPENROUTER_API_KEY (no separate ElevenLabs account).
# Fixed model: elevenlabs/eleven-v4-turbo. Use a supported OpenRouter voice name.
OPENROUTER_TTS_VOICE=sarah
# Separate PRIVATE R2 bucket, without r2.dev or a public custom domain.
# Local SeaweedFS creates this bucket on first photo import.
S3_SOURCE_BUCKET=savorly-sources
# Owners of the admin console (docs/ADMIN.md), comma separated. Each needs a verified email
# outside local development. Defaults to yurlovandrew@gmail.com when unset.
ADMIN_EMAILS=yurlovandrew@gmail.com
# Off until launch: everyone gets unlimited Free use (bounded by the daily budgets above),
# no prices are shown, and Stripe is unused. Set to true to enforce allowances and sell
# Plus and Pro through Stripe Checkout (docs/PRICING.md).
PAID_PLANS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_AUTOMATIC_TAX=false
# Where checkout and the billing portal return to (defaults to the first allowed origin).
APP_URL=
# Sign in with Apple and Google (docs/SIGN-IN.md). Optional; client IDs are public.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_BUNDLE_ID=
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=
# Apple's Sign in with Apple key, to revoke access when an account is deleted.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
