# Staging backend secrets. Copy to .env.staging (git-ignored), fill in, then run
# `npm run deploy:staging`. Every non-empty line is uploaded as a Worker secret and passed
# to the API container. Non-secret settings (models, bucket names, AI budgets, APP_ENV,
# SEED_DATA) live in infra/cloudflare/wrangler.jsonc under env.staging; don't repeat them here.
# Step-by-step: docs/STAGING.md.

# ---- Required ----
# Neon project "savorly-staging" → Connect → direct (non-pooled) connection string.
DATABASE_URL=
# The staging site (the Worker's custom domain in wrangler.jsonc).
ALLOWED_ORIGINS=https://staging.savorly.cooking
APP_URL=https://staging.savorly.cooking
# Cloudflare dashboard → R2 → Manage API tokens → Object Read & Write on
# savorly-staging-media and savorly-staging-sources.
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 → savorly-staging-media → Settings → Public Development URL (https://pub-….r2.dev).
S3_PUBLIC_URL=

# ---- AI (optional; each feature stays hidden in the app until its key is set) ----
# openrouter.ai → Keys. Sous-chef, recipe generation, cover images and narration.
OPENROUTER_API_KEY=
# platform.openai.com → project → API keys. Live voice conversations (needs gpt-live-1 access).
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
# reapi.ai → Dashboard → API Keys. Generated recipe videos (Pro plan only).
REAPI_API_KEY=

# ---- Sign in with Google on Android (optional) ----
# Google Cloud → Google Auth Platform → Clients → the Web application client ID.
GOOGLE_WEB_CLIENT_ID=

# ---- Password-reset email (optional; needs a domain on Cloudflare DNS) ----
# Cloudflare → Compute → Email Service → Email Sending → Onboard Domain. Then My Profile →
# API Tokens → custom token with Account → Email Sending: Edit. Account ID: `wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
# A plain address on the onboarded domain.
EMAIL_FROM=noreply@savorly.cooking

# No Stripe keys: paid plans are off (PAID_PLANS=false) and everyone has unlimited Free.
