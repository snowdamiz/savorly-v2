# Production backend secrets. Copy to .env.production (git-ignored), fill in, then run
# `npm run deploy:production`. Every non-empty line is uploaded as a Worker secret and passed
# to the API container. Non-secret settings (models, bucket names, AI budgets, APP_ENV,
# SEED_DATA, PAID_PLANS) are the top-level vars in infra/cloudflare/wrangler.jsonc.
# Step-by-step: docs/PRODUCTION.md.

# ---- Required ----
# Neon project "savorly-production" → Connect → direct (non-pooled) connection string.
DATABASE_URL=
ALLOWED_ORIGINS=https://savorly.cooking
APP_URL=https://savorly.cooking
# Cloudflare → R2 → Manage API tokens → Object Read & Write on savorly-media and savorly-sources.
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# savorly-media's custom domain.
S3_PUBLIC_URL=https://media.savorly.cooking

# ---- AI (optional; each feature stays hidden in the app until its key is set) ----
# Prefer production keys with their own spending limits, separate from staging's.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
REAPI_API_KEY=

# ---- Sign in with Google (optional) ----
# The Web application client ID; its JavaScript origins must include https://savorly.cooking.
GOOGLE_WEB_CLIENT_ID=
# iOS only, once the iOS OAuth client exists (docs/SIGN-IN.md).
GOOGLE_IOS_CLIENT_ID=

# ---- Sign in with Apple (optional; needs the Apple Developer setup in docs/SIGN-IN.md) ----
# Any value here turns Apple sign-in on, so leave these empty until Apple is configured:
# APPLE_BUNDLE_ID=app.savorly.mobile, APPLE_REDIRECT_URI=https://savorly.cooking/auth/apple.
APPLE_BUNDLE_ID=
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Password-reset email (Cloudflare Email Service on savorly.cooking) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM=noreply@savorly.cooking

# No Stripe keys: paid plans are off (PAID_PLANS=false) and everyone has unlimited Free.
