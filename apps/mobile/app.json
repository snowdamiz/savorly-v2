{
  "expo": {
    "name": "Savorly",
    "slug": "savorly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": { "url": "https://u.expo.dev/c0e4c4a0-bfbf-4b82-9701-0e46c9463c6c" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.savorly.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:savorly.cooking"]
    },
    "android": {
      "package": "app.savorly.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F7F8F5"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "savorly.cooking", "pathPrefix": "/recipes/" },
            { "scheme": "https", "host": "savorly.cooking", "pathPrefix": "/cookbooks/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Savorly — A little inspiration for your kitchen",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Let Savorly access your photos to add images and videos to your recipes and a picture to your profile.",
          "cameraPermission": "Let Savorly use the camera to photograph recipes for your cooking assistant and to take your profile photo.",
          "microphonePermission": "Let Savorly listen while you describe your recipe."
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-video",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Let Savorly listen and talk with you to create recipes.",
          "cameraPermission": "Let Savorly use the camera to photograph recipes for your cooking assistant and to take your profile photo."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Let Savorly listen while you describe your recipe.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Let Savorly use the camera to photograph recipes for your cooking assistant and to take your profile photo.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-asset",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0D0D0D"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "fr", "de", "ru", "es", "it", "pt", "zh-Hans", "ja"]
        }
      ]
    ],
    "scheme": "savorly",
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "ru": "./locales/ru.json",
      "es": "./locales/es.json",
      "it": "./locales/it.json",
      "pt": "./locales/pt.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "ja": "./locales/ja.json"
    },
    "extra": {
      "eas": {
        "projectId": "c0e4c4a0-bfbf-4b82-9701-0e46c9463c6c"
      }
    },
    "owner": "120356aa-user"
  }
}
